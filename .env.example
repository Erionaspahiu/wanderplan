VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Duffel (duffel.com) — free signup at https://app.duffel.com/join, no
# credit card needed for a test token. Server-side only: read by
# api/flights/*.js, never bundled into the frontend. duffel_test_...
# tokens return sandbox data; duffel_live_... tokens (after account
# verification) return real airline data.
DUFFEL_API_TOKEN=duffel_test_your-token-here
